# ---- Server ----
PORT=4000
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Leave MONGODB_URI empty to run in in-memory mode seeded from src/data/players.json.
# Set it to use MongoDB; run `npm run seed` once to load the player data.
MONGODB_URI=
MONGODB_DB_NAME=ipl_auction

# ---- LLM ----
# gemini    : Google Gemini (default when GOOGLE_API_KEY is set)
# anthropic : Claude
# Without any key the assistant falls back to a deterministic, retrieval-only answerer.
LLM_PROVIDER=gemini

# Get a key free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Embeddings ----
# local  : zero-dependency hashed TF-IDF embedder (no API key needed)
# gemini : gemini-embedding-001 dense embeddings (recommended, uses GOOGLE_API_KEY)
# cohere : Cohere dense embeddings
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
COHERE_API_KEY=
COHERE_MODEL=embed-english-v3.0

# ---- Retrieval ----
RAG_TOP_K=6
